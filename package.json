{
  "name": "aced",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d",
    "db:generate": "pnpm --filter @aced/db db:generate",
    "db:migrate": "pnpm --filter @aced/db db:migrate",
    "db:studio": "pnpm --filter @aced/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "turbo": "^2.11.13"
  }
}
