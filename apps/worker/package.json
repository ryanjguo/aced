{
  "name": "@aced/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.exclude='src/index.ts' --coverage.exclude='src/env.ts' --coverage.exclude='src/scripts/**'",
    "cards:enqueue": "tsx src/scripts/enqueue-completed.ts",
    "roster:simulate": "tsx src/scripts/simulate-transfer.ts"
  },
  "dependencies": {
    "@aced/db": "workspace:*",
    "@aced/jobs": "workspace:*",
    "@aced/ranking": "workspace:*",
    "@aced/redis": "workspace:*",
    "@aced/types": "workspace:*",
    "@sentry/node": "^11.16.0",
    "bullmq": "^6.7.8"
  },
  "devDependencies": {
    "@aced/tsconfig": "workspace:*",
    "@types/node": "^22",
    "@vitest/coverage-v8": "5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
