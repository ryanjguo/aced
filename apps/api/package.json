{
  "name": "@aced/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.exclude='src/index.ts' --coverage.exclude='src/env.ts'"
  },
  "dependencies": {
    "@aced/db": "workspace:*",
    "@aced/jobs": "workspace:*",
    "@aced/moderation": "workspace:*",
    "@aced/ranking": "workspace:*",
    "@aced/redis": "workspace:*",
    "@aced/types": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "@sentry/node": "^11.16.0",
    "better-auth": "^1.7.27",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aced/tsconfig": "workspace:*",
    "@types/node": "^22",
    "@vitest/coverage-v8": "5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
